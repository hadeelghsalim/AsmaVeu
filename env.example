# =================================================================
# AsmaVeu — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# This file contains variable NAMES only — no real values.
# =================================================================

# -----------------------------------------------------------------
# PostgreSQL — stores contacts, assessments and n8n's own state
# -----------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=asmaveu
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# n8n — workflow orchestration
# -----------------------------------------------------------------
N8N_HOST=
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Madrid

# Required so the HTTP Request node can read $env.TELEGRAM_BOT_TOKEN
# instead of having the token hardcoded in the workflow URL.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Encrypts n8n's stored credentials. Generate once and keep it stable —
# changing it makes existing saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------
# Telegram — patient-facing channel
# Obtain from @BotFather. Revoke with /revoke if ever exposed.
# -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------
# OpenAI — conversational agent + Whisper voice transcription
# -----------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------
# pgAdmin — database administration UI
# -----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# -----------------------------------------------------------------
# Metabase — nurse-facing dashboard
# -----------------------------------------------------------------
MB_PORT=3000
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_USER=
MB_DB_PASS=
